theorem DhPoc.PPT.session_secure_isPPTBy.{u_1, u_2} : ∀ {D P K G : ℕ → Type} {q w : ℕ → ℕ}
  [inst : ∀ (n : ℕ), Fact (Nat.Prime (q n))] [inst_1 : (n : ℕ) → AddCommGroup (G n)]
  [inst_2 : (n : ℕ) → Module (ZMod (q n)) (G n)]
  (M : (n : ℕ) → DhPoc.PrimeOrderModel (D n) (P n) (K n) (G n) (q n) (w n)) (b : ℕ → ℕ),
  (∀ (n : ℕ), q n ≤ 2 ^ b n) →
    (∀ (n : ℕ), b n + n + 2 ≤ w n) →
      ∀ {C : PFunctor.StepClass} [inst_3 : C.HasProd] [inst_4 : C.HasSum] [inst_5 : C.HasOption]
        (Q : PFunctor.QuantitativeStepClass C) [inst_6 : Q.HasComposition]
        (bd : PFunctor.DynSystem.DynComputation.Boundary C coinSpec.toPFunctor (DhPoc.PPT.SessionInput P K) Bool)
        (ddhInputRep : C.Str (DhPoc.PPT.DDHInput G)) (composition : Q.PolynomialComposition)
        (encoding : Q.PolyRealizer ddhInputRep bd.input (DhPoc.PPT.encodeInput M)),
        (DhPoc.PPT.ddhGame M).secureAgainst (OracleComp.Complexity.IsPPTBy Q (bd.withInput ddhInputRep)) →
          (DhPoc.PPT.sessionGame M).secureAgainst (OracleComp.Complexity.IsPPTBy Q bd) :=
fun {D P K G} {q w} [∀ (n : ℕ), Fact (Nat.Prime (q n))] [(n : ℕ) → AddCommGroup (G n)]
    [(n : ℕ) → Module (ZMod (q n)) (G n)] M b hq hw {C} [C.HasProd] [C.HasSum] [C.HasOption] Q [Q.HasComposition] bd
    ddhInputRep composition encoding hDDH A hA =>
  DhPoc.parameterizedSessionAdvantage_negligible M (DhPoc.PPT.sessionFamily A) b hq hw
    (have hreduce := DhPoc.PPT.isPPTBy_precomp composition encoding hA;
    hDDH (DhPoc.PPT.reduce M A) hreduce)
