info: Concrete/Audit.lean:15:0: theorem DhConcrete.nativeAdvantage_eq : Aeneas.Std.target = "x86_64-no-tables" →
  ∀ (μ ν : ProbComp DhConcrete.Secret)
    (adversary : DhConcrete.Public → DhConcrete.Public → DhConcrete.Key → ProbComp Bool),
    DhConcrete.nativeAdvantage μ ν adversary =
      DhPoc.sampledDDHAdvantage DhConcrete.decodeScalar DhConcrete.generator μ ν
        (DhPoc.rawReduction DhConcrete.model adversary) :=
fun hTarget μ ν adversary =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          _a =
            DhPoc.sampledDDHAdvantage DhConcrete.decodeScalar DhConcrete.generator μ ν
              (DhPoc.rawReduction DhConcrete.model adversary))
        (DhConcrete.nativeAdvantage.eq_1 μ ν adversary)))
    (Eq.mpr
      (id
        (congrArg
          (fun _a =>
            𝒟[_a].boolDist 𝒟[DhConcrete.nativeIdeal μ ν adversary] =
              DhPoc.sampledDDHAdvantage DhConcrete.decodeScalar DhConcrete.generator μ ν
                (DhPoc.rawReduction DhConcrete.model adversary))
          (DhConcrete.nativeReal_eq hTarget μ ν adversary)))
      (Eq.mpr
        (id
          (congrArg
            (fun _a =>
              𝒟[DhPoc.sampledReal DhConcrete.model μ ν adversary].boolDist 𝒟[_a] =
                DhPoc.sampledDDHAdvantage DhConcrete.decodeScalar DhConcrete.generator μ ν
                  (DhPoc.rawReduction DhConcrete.model adversary))
