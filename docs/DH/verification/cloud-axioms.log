theorem DhConcrete.wideAdvantage_le_standard : Aeneas.Std.target = "x86_64-no-tables" →
  ∀ (adversary : DhConcrete.Public → DhConcrete.Public → DhConcrete.Key → ProbComp Bool),
    DhConcrete.nativeAdvantage DhConcrete.uniformWide DhConcrete.uniformWide adversary ≤
      DiffieHellman.ddhAdvantage DhConcrete.generator (DhPoc.rawReduction DhConcrete.model adversary) +
        4 * DhConcrete.wideSamplingError :=
fun hTarget adversary =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          _a ≤
            DiffieHellman.ddhAdvantage DhConcrete.generator (DhPoc.rawReduction DhConcrete.model adversary) +
              4 * DhConcrete.wideSamplingError)
        (DhConcrete.wideAdvantage_eq hTarget adversary)))
    (LE.le.trans
      (DhPoc.sampledDDHAdvantage_le_standard DhConcrete.decodeScalar DhConcrete.generator DhConcrete.uniformWide
        DhConcrete.uniformWide (DhPoc.rawReduction DhConcrete.model adversary))
      (have h :=
        Eq.mpr
          (id
            (congrArg
              (LE.le (measureETVDist (DhConcrete.decodeScalar <$> DhConcrete.uniformWide) ($ᵗ DhConcrete.Scalar)))
              (congrArg (HDiv.hDiv ↑(256 ^ 64 % curve25519.L)) (Nat.cast_pow 256 64))))
          (Eq.mp
            (congrArg
              (LE.le (measureETVDist (DhConcrete.decodeScalar <$> DhConcrete.uniformWide) ($ᵗ DhConcrete.Scalar)))
              (congrArg (HDiv.hDiv ↑(256 ^ 64 % curve25519.L)) (Nat.cast_pow 256 64)))
            DhConcrete.uniformWide_scalar_measureETVDist_le);
      have hsum :=
        mul_le_mul
          (have this := le_rfl;
          this)
          (add_le_add h h) bot_le bot_le;
      have heq :=
        Mathlib.Tactic.Ring.of_eq
          (Mathlib.Tactic.Ring.Common.mul_congr
            (Mathlib.Tactic.Ring.cast_pos (Mathlib.Meta.NormNum.isNat_ofNat ENNReal (Eq.refl 2)))
            (Mathlib.Tactic.Ring.Common.add_congr
              (Mathlib.Tactic.Ring.Common.atom_pf DhConcrete.wideSamplingError rfl
                (Eq.mpr
                  (id
                    (congrArg
                      (fun _a =>
                        DhConcrete.wideSamplingError ^ Nat.rawCast 1 * Nat.rawCast 1 =
                          DhConcrete.wideSamplingError ^ Nat.rawCast 1 * _a)
                      (Eq.symm rfl)))
                  (Eq.refl (DhConcrete.wideSamplingError ^ Nat.rawCast 1 * Nat.rawCast 1))))
              (Mathlib.Tactic.Ring.Common.atom_pf DhConcrete.wideSamplingError rfl
                (Eq.mpr
                  (id
                    (congrArg
                      (fun _a =>
                        DhConcrete.wideSamplingError ^ Nat.rawCast 1 * Nat.rawCast 1 =
                          DhConcrete.wideSamplingError ^ Nat.rawCast 1 * _a)
                      (Eq.symm rfl)))
                  (Eq.refl (DhConcrete.wideSamplingError ^ Nat.rawCast 1 * Nat.rawCast 1))))
              (Mathlib.Tactic.Ring.Common.add_pf_add_overlap
                (Mathlib.Tactic.Ring.Common.add_overlap_pf DhConcrete.wideSamplingError (Nat.rawCast 1)
                  (Mathlib.Meta.NormNum.IsNat.to_raw_eq
                    (Mathlib.Meta.NormNum.isNat_add (Eq.refl HAdd.hAdd) (Mathlib.Meta.NormNum.IsNat.of_raw ENNReal 1)
                      (Mathlib.Meta.NormNum.IsNat.of_raw ENNReal 1) (Eq.refl 2))))
                (Mathlib.Tactic.Ring.Common.add_pf_zero_add 0)))
            (Mathlib.Tactic.Ring.Common.add_mul
              (Mathlib.Tactic.Ring.Common.mul_add
                (Mathlib.Tactic.Ring.Common.mul_pf_right DhConcrete.wideSamplingError (Nat.rawCast 1)
                  (Mathlib.Meta.NormNum.IsNat.to_raw_eq
                    (Mathlib.Meta.NormNum.isNat_mul (Eq.refl HMul.hMul) (Mathlib.Meta.NormNum.IsNat.of_raw ENNReal 2)
                      (Mathlib.Meta.NormNum.IsNat.of_raw ENNReal 2) (Eq.refl 4))))
                (Mathlib.Tactic.Ring.Common.mul_zero (Nat.rawCast 2))
                (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                  (DhConcrete.wideSamplingError ^ Nat.rawCast 1 * Nat.rawCast 4 + 0)))
              (Mathlib.Tactic.Ring.Common.zero_mul (DhConcrete.wideSamplingError ^ Nat.rawCast 1 * Nat.rawCast 2 + 0))
              (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                (DhConcrete.wideSamplingError ^ Nat.rawCast 1 * Nat.rawCast 4 + 0))))
          (Mathlib.Tactic.Ring.Common.mul_congr
            (Mathlib.Tactic.Ring.cast_pos (Mathlib.Meta.NormNum.isNat_ofNat ENNReal (Eq.refl 4)))
            (Mathlib.Tactic.Ring.Common.atom_pf DhConcrete.wideSamplingError rfl
              (Eq.mpr
                (id
                  (congrArg
                    (fun _a =>
                      DhConcrete.wideSamplingError ^ Nat.rawCast 1 * Nat.rawCast 1 =
                        DhConcrete.wideSamplingError ^ Nat.rawCast 1 * _a)
                    (Eq.symm rfl)))
                (Eq.refl (DhConcrete.wideSamplingError ^ Nat.rawCast 1 * Nat.rawCast 1))))
            (Mathlib.Tactic.Ring.Common.add_mul
              (Mathlib.Tactic.Ring.Common.mul_add
                (Mathlib.Tactic.Ring.Common.mul_pf_right DhConcrete.wideSamplingError (Nat.rawCast 1)
                  (Mathlib.Meta.NormNum.IsNat.to_raw_eq
                    (Mathlib.Meta.NormNum.isNat_mul (Eq.refl HMul.hMul) (Mathlib.Meta.NormNum.IsNat.of_raw ENNReal 4)
                      (Mathlib.Meta.NormNum.IsNat.of_raw ENNReal 1) (Eq.refl 4))))
                (Mathlib.Tactic.Ring.Common.mul_zero (Nat.rawCast 4))
                (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                  (DhConcrete.wideSamplingError ^ Nat.rawCast 1 * Nat.rawCast 4 + 0)))
              (Mathlib.Tactic.Ring.Common.zero_mul (DhConcrete.wideSamplingError ^ Nat.rawCast 1 * Nat.rawCast 1 + 0))
              (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                (DhConcrete.wideSamplingError ^ Nat.rawCast 1 * Nat.rawCast 4 + 0))));
      add_le_add le_rfl
        (Eq.mp
          (congrArg
            (fun _a =>
              2 *
                  (measureETVDist (DhConcrete.decodeScalar <$> DhConcrete.uniformWide) ($ᵗ DhConcrete.Scalar) +
                    measureETVDist (DhConcrete.decodeScalar <$> DhConcrete.uniformWide) ($ᵗ DhConcrete.Scalar)) ≤
                _a)
            heq)
          hsum)))
theorem DhConcrete.wideAdvantage_le_of_standardDDH : Aeneas.Std.target = "x86_64-no-tables" →
  ∀ (adversary : DhConcrete.Public → DhConcrete.Public → DhConcrete.Key → ProbComp Bool) (ε : ENNReal),
    DiffieHellman.ddhAdvantage DhConcrete.generator (DhPoc.rawReduction DhConcrete.model adversary) ≤ ε →
      DhConcrete.nativeAdvantage DhConcrete.uniformWide DhConcrete.uniformWide adversary ≤ ε + (2 ^ 260)⁻¹ :=
fun hTarget adversary ε hDDH =>
  LE.le.trans (DhConcrete.wideAdvantage_le_standard hTarget adversary)
    (add_le_add hDDH (LT.lt.le DhConcrete.four_wideSamplingError_lt))
