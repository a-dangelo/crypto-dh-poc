  ∀ (adversary : DhConcrete.Public → DhConcrete.Public → DhConcrete.Key → ProbComp Bool),
    DhConcrete.nativeAdvantage DhConcrete.uniformWide DhConcrete.uniformWide adversary =
      DhPoc.sampledDDHAdvantage DhConcrete.decodeScalar DhConcrete.generator DhConcrete.uniformWide
        DhConcrete.uniformWide (DhPoc.rawReduction DhConcrete.model adversary) :=
fun hTarget adversary => DhConcrete.nativeAdvantage_eq hTarget DhConcrete.uniformWide DhConcrete.uniformWide adversary
theorem DhConcrete.wideAdvantage_le : Aeneas.Std.target = "x86_64-no-tables" →
  ∀ (adversary : DhConcrete.Public → DhConcrete.Public → DhConcrete.Key → ProbComp Bool) (ε : ENNReal),
    DhPoc.sampledDDHAdvantage DhConcrete.decodeScalar DhConcrete.generator DhConcrete.uniformWide DhConcrete.uniformWide
          (DhPoc.rawReduction DhConcrete.model adversary) ≤
        ε →
      DhConcrete.nativeAdvantage DhConcrete.uniformWide DhConcrete.uniformWide adversary ≤ ε :=
fun hTarget adversary ε hDDH =>
