                  (Mathlib.Tactic.Ring.Common.mul_add
                    (Mathlib.Tactic.Ring.Common.mul_pf_right (DhPoc.samplingError q w) (Nat.rawCast 1)
                      (Mathlib.Meta.NormNum.IsNat.to_raw_eq
                        (Mathlib.Meta.NormNum.isNat_mul (Eq.refl HMul.hMul)
                          (Mathlib.Meta.NormNum.IsNat.of_raw ENNReal 5) (Mathlib.Meta.NormNum.IsNat.of_raw ENNReal 1)
                          (Eq.refl 5))))
                    (Mathlib.Tactic.Ring.Common.mul_zero (Nat.rawCast 5))
                    (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                      (DhPoc.samplingError q w ^ Nat.rawCast 1 * Nat.rawCast 5 + 0)))
                  (Mathlib.Tactic.Ring.Common.zero_mul (DhPoc.samplingError q w ^ Nat.rawCast 1 * Nat.rawCast 1 + 0))
                  (Mathlib.Tactic.Ring.Common.add_pf_add_zero
                    (DhPoc.samplingError q w ^ Nat.rawCast 1 * Nat.rawCast 5 + 0))))
              (Mathlib.Tactic.Ring.Common.add_pf_add_lt
                (DiffieHellman.ddhAdvantage M.generator (DhPoc.rawReduction M.toRawPrimitiveModel B) ^ Nat.rawCast 1 *
                  Nat.rawCast 1)
                (Mathlib.Tactic.Ring.Common.add_pf_zero_add
                  (DhPoc.samplingError q w ^ Nat.rawCast 1 * Nat.rawCast 5 + 0))))))))
theorem DhPoc.CoinSecurity.session_secure_isPPTBy.{u_1, u_2} : ∀ {D P K G : ℕ → Type} {q w : ℕ → ℕ}
  [inst : ∀ (n : ℕ), Fact (Nat.Prime (q n))] [inst_1 : (n : ℕ) → AddCommGroup (G n)]
  [inst_2 : (n : ℕ) → Module (ZMod (q n)) (G n)]
  (M : (n : ℕ) → DhPoc.PrimeOrderModel (D n) (P n) (K n) (G n) (q n) (w n)) (b : ℕ → ℕ),
  (∀ (n : ℕ), q n ≤ 2 ^ b n) →
    (∀ (n : ℕ), b n + n + 2 ≤ w n) →
      ∀ {C : PFunctor.StepClass} [inst_3 : C.HasProd] [inst_4 : C.HasSum] [inst_5 : C.HasOption]
        (Q : PFunctor.QuantitativeStepClass C) [inst_6 : Q.HasComposition]
        (bd : PFunctor.DynSystem.DynComputation.Boundary C coinSpec.toPFunctor (DhPoc.PPT.SessionInput P K) Bool)
        (ddhInputRep : C.Str (DhPoc.PPT.DDHInput G)) (composition : Q.PolynomialComposition)
        (encoding : Q.PolyRealizer ddhInputRep bd.input (DhPoc.PPT.encodeInput M)),
        (DhPoc.PPT.ddhGame M).secureAgainst (OracleComp.Complexity.IsPPTBy Q (bd.withInput ddhInputRep)) →
          (DhPoc.CoinSecurity.sessionGame M).secureAgainst (OracleComp.Complexity.IsPPTBy Q bd) :=
fun {D P K G} {q w} [∀ (n : ℕ), Fact (Nat.Prime (q n))] [(n : ℕ) → AddCommGroup (G n)]
    [(n : ℕ) → Module (ZMod (q n)) (G n)] M b hq hw {C} [C.HasProd] [C.HasSum] [C.HasOption] Q [Q.HasComposition] bd
    ddhInputRep composition encoding hDDH A hA =>
  DhPoc.CoinSecurity.advantage_negligible M A b hq hw
    (hDDH (DhPoc.PPT.reduce M A) (DhPoc.PPT.isPPTBy_precomp composition encoding hA))
theorem DhPoc.CoinResources.games_polynomial_coinBound.{u_1, u_2} : ∀ {C : PFunctor.StepClass} [inst : C.HasProd]
  [inst_1 : C.HasSum] [inst_2 : C.HasOption] {Q : PFunctor.QuantitativeStepClass C} {D P K G : ℕ → Type} {q w : ℕ → ℕ}
  [inst_3 : ∀ (n : ℕ), Fact (Nat.Prime (q n))] [inst_4 : (n : ℕ) → AddCommGroup (G n)]
  [inst_5 : (n : ℕ) → Module (ZMod (q n)) (G n)]
  (M : (n : ℕ) → DhPoc.PrimeOrderModel (D n) (P n) (K n) (G n) (q n) (w n))
  {bd : PFunctor.DynSystem.DynComputation.Boundary C coinSpec.toPFunctor (DhPoc.PPT.SessionInput P K) Bool}
  (A : DhPoc.PPT.SessionAdversary P K),
  OracleComp.Complexity.IsPPTBy Q bd A →
    ∀ (inputBound widthBound : Complexity.FirstOrderPolynomial),
      (∀ (n : ℕ) (pa pb : P n) (k : K n), Q.size bd.input ⟨n, (pa, pb, k)⟩ ≤ inputBound.eval n) →
        (∀ (n : ℕ), w n ≤ widthBound.eval n) →
          ∃ p,
            ∀ (n : ℕ),
              PFunctor.FreeM.IsTotalRollBound (DhPoc.CoinSecurity.real (M n) fun pa pb k => A ⟨n, (pa, pb, k)⟩)
                  (p.eval n) ∧
                PFunctor.FreeM.IsTotalRollBound (DhPoc.CoinSecurity.ideal (M n) fun pa pb k => A ⟨n, (pa, pb, k)⟩)
                  (p.eval n) :=
fun {C} [C.HasProd] [C.HasSum] [C.HasOption] {Q} {D P K G} {q w} [∀ (n : ℕ), Fact (Nat.Prime (q n))]
    [(n : ℕ) → AddCommGroup (G n)] [(n : ℕ) → Module (ZMod (q n)) (G n)] M {bd} A hppt inputBound widthBound hinput
    hwidth =>
  let ⟨r, hr⟩ :=
    DhPoc.CoinResources.isPPTBy_parameterBound hppt inputBound fun n x =>
      match x with
      | (pa, pb, k) => hinput n pa pb k
  Exists.intro (((Complexity.FirstOrderPolynomial.const 3).mul widthBound).add r) fun n =>
    have hreal :=
      DhPoc.CoinSecurity.real_rollBound (M n) (fun pa pb k => A ⟨n, (pa, pb, k)⟩) (r.eval n) fun pa pb k =>
        hr n (pa, pb, k);
    have hideal :=
      DhPoc.CoinSecurity.ideal_rollBound (M n) (fun pa pb k => A ⟨n, (pa, pb, k)⟩) (r.eval n) fun pa pb k =>
        hr n (pa, pb, k);
    id
      ⟨PFunctor.FreeM.IsTotalRollBound.mono hreal
          (have this := hwidth n;
          Decidable.byContradiction fun a =>
            DhPoc.CoinResources.games_polynomial_coinBound._proof_1_3 widthBound r n this a),
        PFunctor.FreeM.IsTotalRollBound.mono hideal
          (Nat.add_le_add_right (Nat.mul_le_mul_left 3 (hwidth n)) (r.eval n))⟩
